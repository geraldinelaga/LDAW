 //pedidosDe(nombreCliente) debe usar filter sobre el array de pedidos.


//LocalDeHelados puede tener muchos Pedidos, y cada Pedido pertenece a un solo LocalDeHelados. Entonces, la relación entre LocalDeHelados y Pedido es de uno a muchos.

//Pedido puede tener un solo Cliente, y cada Cliente puede tener muchos Pedidos. Entonces, la relación entre Pedido y Cliente es de uno a muchos.


class LocalDeHelados {
    constructor() {
        this.pedidos = [];
    }

    registrarPedido(pedido) {
        this.pedidos.push(pedido);
    }

    pedidosDe(nombreCliente){
        return this.pedidos.filter(p => p.cliente.nombreCliente === nombreCliente);
    }
}

class Cliente {
    constructor(nombreCliente, telefono) {
        this.nombreCliente = nombreCliente;
        this.telefono = telefono;
    }

    mostrarCliente(){
        return `${this.nombreCliente} - ${this.telefono}`;
    }

}

class Pedido { 
    constructor(cliente, total) {
        this.cliente = cliente;
        this.total = total;
    }

    
}
 
